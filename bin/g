#!/bin/bash

SRC=${1:-a.cpp}
OUT=${2:-a.out}

find_root() {
    local dir="$PWD"
    while [ "$dir" != "/" ]; do
        if [ -d "$dir/lib" ] && [ -d "$dir/verify" ]; then
            echo "$dir"
            return 0
        fi
        dir=$(dirname "$dir")
    done
    return 1
}

ROOT=$(find_root) || {
    echo "kyopro root not found" >&2
    exit 1
}

g++ -std=c++17 -I"$ROOT" -include "$ROOT/pch/stdc++.h" "$SRC" -o "$OUT"